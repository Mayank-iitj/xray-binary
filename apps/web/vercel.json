{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/login-photo.jpg",
      "destination": "/assets/login-photo.jpg"
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/favicon.ico"
    },
    {
      "source": "/api/:match*",
      "destination": "https://xray-binary-api.onrender.com/api/:match*"
    }
  ]
}

