{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/web/landing.html"
    },
    {
      "source": "/app",
      "destination": "/apps/web/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/apps/web/index.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/apps/web/assets/:path*"
    },
    {
      "source": "/login-photo.jpg",
      "destination": "/apps/web/assets/login-photo.jpg"
    },
    {
      "source": "/api/:match*",
      "destination": "https://xray-binary-api.onrender.com/api/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
